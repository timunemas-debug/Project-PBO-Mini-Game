<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="rootmemilihcharacter"
           xmlns:fx="https://javafx.com/fxml"
           fx:controller="com.gui.controller.MemilihCharacterController"
           stylesheets="@/css/style.css">

    <ImageView fx:id="bgImageMemilihCharacter"
               preserveRatio="false"
               smooth="true"/>

    <HBox alignment="CENTER"
          spacing="40">
          <padding>
            <Insets top="100" bottom="50"/>
          </padding>
        
          
          <Button fx:id="btnMemilihLyra"
          styleClass="btn-memilihlyra"
          onAction="#handlePlayerLyra">
          <graphic>
                  <ImageView fitWidth="420" fitHeight="420" preserveRatio="true">
                          <image>
                                  <Image url="@/Images/Lyra.png"/>
                                </image>
                        </ImageView>
                </graphic>
        </Button>
        
        <Button fx:id="btnMemilihDraven"
                styleClass="btn-memilihdraven"
                onAction="#handlePlayerDraven">
                <graphic>
                        <ImageView fitWidth="420" fitHeight="420" preserveRatio="true">
                                <image>
                                        <Image url="@/Images/Draven.png"/>
                                </image>
                        </ImageView>
                </graphic>
        </Button>

        <Button fx:id="btnMemilihKaelion"
                styleClass="btn-memilihkaelion"
                onAction="#handlePlayerKaelion">
                <graphic>
                        <ImageView fitWidth="420" fitHeight="420" preserveRatio="true">
                                <image>
                                        <Image url="@/Images/Kaelion.png"/>
                                </image>
                        </ImageView>
                </graphic>
        </Button>
        
    </HBox>
</StackPane>