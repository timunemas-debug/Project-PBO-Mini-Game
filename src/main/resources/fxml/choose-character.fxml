<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="rootmemilihcharacter"
           xmlns:fx="https://javafx.com/fxml"
           fx:controller="com.gui.controller.MemilihCharacterController"
           stylesheets="@/css/style.css">

    <ImageView fx:id="bgImageMemilihCharacter"
               preserveRatio="false"
               smooth="true"/>

    <HBox alignment="CENTER"
          spacing="25">
          <padding>
            <Insets bottom="50"/>
          </padding>
        
        <Button fx:id="btnMemilihDraven"
                prefWidth="250"
                prefHeight="50"
                styleClass="btn-memilihdraven"
                onAction="#handlePlayerDraven">
                <graphic>
                        <ImageView fitWidth="300" fitHeight="300" preserveRatio="true">
                                <image>
                                        <Image url="@/Images/lyradisplay.png"/>
                                </image>
                        </ImageView>
                </graphic>
        </Button>
                
        <Button fx:id="btnMemilihLyra"
                prefWidth="250"
                prefHeight="50"
                styleClass="btn-memilihlyra"
                onAction="#handlePlayerLyra">
                <graphic>
                        <ImageView fitWidth="300" fitHeight="300" preserveRatio="true">
                                <image>
                                        <Image url="@/Images/lyradisplay.png"/>
                                </image>
                        </ImageView>
                </graphic>
        </Button>

        <Button fx:id="btnMemilihKaelion"
                text="KAELION"
                prefWidth="250"
                prefHeight="50"
                styleClass="btn-memilihkaelion"
                onAction="#handlePlayerKaelion">
                <graphic>
                        <ImageView fitWidth="300" fitHeight="300" preserveRatio="true">
                                <image>
                                        <Image url="@/Images/lyradisplay.png"/>
                                </image>
                        </ImageView>
                </graphic>
        </Button>
        
    </HBox>
</StackPane>