<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.AnchorPane?>

<StackPane fx:id="rootpertempuran"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.gui.controller.GameController"
           stylesheets="@/css/style.css">

    <ImageView fx:id="bgimagepertempuran"
               fitWidth="${rootpertempuran.width}"
               fitHeight="${rootpertempuran.height}"
               preserveRatio="false"
               smooth="true"
               mouseTransparent="true"/>

    <ImageView fx:id="gameoverbgImageView"
               fitWidth="${rootpertempuran.width}"
               fitHeight="${rootpertempuran.height}"
               preserveRatio="false"
               smooth="true"
               mouseTransparent="true"/>

   <AnchorPane StackPane.alignment="CENTER"
                maxWidth="1280"
                mouseTransparent="true">

           <ImageView fx:id="characterImageView"
                      visible="false"
                      fitWidth="400"
                      fitHeight="400"
                      preserveRatio="true"
                      mouseTransparent="true"
                      AnchorPane.leftAnchor="350"
                      AnchorPane.bottomAnchor="0"/>

           <ImageView fx:id="menambahDarahImageView"
                      fitWidth="150"
                      fitHeight="150"
                      preserveRatio="true"
                      visible="false"
                      AnchorPane.leftAnchor="370"
                      AnchorPane.bottomAnchor="100"/>

           <ImageView fx:id="goblinImageView"
                      visible="false"
                      fitWidth="400"
                      fitHeight="400"
                      preserveRatio="true"
                      mouseTransparent="true"
                      AnchorPane.rightAnchor="120"
                      AnchorPane.bottomAnchor="40"/>
                      
           <ImageView fx:id="nagaImageView"
                      visible="false"
                      fitWidth="400"
                      fitHeight="400"
                      preserveRatio="true"
                      mouseTransparent="true"
                      AnchorPane.rightAnchor="120"
                      AnchorPane.bottomAnchor="40"/>

           <ImageView fx:id="npcImageView"
                      visible="false"
                      fitWidth="400"
                      fitHeight="400"
                      preserveRatio="true"
                      mouseTransparent="true"
                      AnchorPane.leftAnchor="50"
                      AnchorPane.bottomAnchor="0"/>
        
           <ImageView fx:id="characterMatiImageView"
                      visible="false"
                      fitWidth="400"
                      fitHeight="400"
                      preserveRatio="true"
                      mouseTransparent="true"
                      AnchorPane.leftAnchor="250"
                      AnchorPane.bottomAnchor="50"/>

           <ImageView fx:id="characterMenyeranImageView"
                      visible="false"
                      fitWidth="400"
                      fitHeight="400"
                      preserveRatio="true"
                      mouseTransparent="true"
                      AnchorPane.rightAnchor="120"
                      AnchorPane.bottomAnchor="40"/>

   </AnchorPane>
<TextArea fx:id="logArea"
          prefHeight="80"
          prefWidth="300"
          maxWidth="300"
          maxHeight="80"
          editable="false"
          wrapText="true"
          visible="false"
          styleClass="log-area"
          StackPane.alignment="TOP_CENTER"/>

        <BorderPane>
                <top>
                        <VBox alignment="CENTER_LEFT"
                              spacing="15">
                        <padding>
                            <Insets top="20" left="20"/>
                        </padding>
                        <Button fx:id="btnExit"
                                text="EXIT"
                                prefWidth="250"
                                prefHeight="50"
                                styleClass="btn-exit-pertempuran"
                                onAction="#exitGame"/>
                        <Button fx:id="btnNext"
                                text="NEXT"
                                onAction="#nextDialog"
                                visible="false"/>
                    </VBox>
                </top>

                <bottom>
                        <HBox alignment="CENTER"
                               spacing="10">
                         <padding>
                           <Insets bottom="20"/>
                         </padding>
                       <Button fx:id="btnJalan"
                               text="JALAN"
                               prefWidth="250"
                               prefHeight="50"
                               styleClass="btn-jalan-pertempuran"
                               onAction="#onJalan"/>
                       <Button fx:id="btnHeal"
                               text="HEAL"
                               prefWidth="250"
                               prefHeight="50"
                               styleClass="btn-heal-pertempuran"
                               onAction="#nambahDarah"/>
                        <Button fx:id="btnAttack"
                                text="ATTACK"
                                prefWidth="250"
                                prefHeight="50"
                                styleClass="btn-attack-pertempuran"
                                onAction="#attackEnemy"/>
                        <Button fx:id="btnNpc"
                                text="BICARA"
                                prefWidth="250"
                                prefHeight="50"
                                onAction="#bicaraNpc"
                                styleClass="btn-bicara-pertempuran"/>
                        <Button fx:id="btnHome"
                                text="HOME"
                                prefWidth="250"
                                prefHeight="50"
                                onAction="#exitGame"
                                visible="false"
                                styleClass="btn-back-home"/>
               
                       </HBox>
                </bottom>

        </BorderPane>

</StackPane>